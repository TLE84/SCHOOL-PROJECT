# Copy to .env.local for local development. Do not commit .env.local.
#
# Everything here is optional. With nothing set, the site serves the built-in
# seed content and uses the hardcoded demo accounts. Each piece switches on
# independently:
#   - DATABASE_URL              → content, comments, reactions and newsletter
#                                 sign-ups come from Postgres (seed data is the
#                                 fallback if it cannot be reached)
#   - Supabase URL + publishable key → real sign-in/sign-up via Supabase Auth
#                                 (the demo accounts are then disabled)
#   - SUPABASE_SERVICE_ROLE_KEY → saves the role chosen at sign-up and powers
#                                 the admin Users page and `npm run auth:set-role`
#
# Check your values with `npm run supabase:check`.
# On Vercel, add the same variables and redeploy (NEXT_PUBLIC_* values are
# baked in at build time).

# Canonical origin, used for metadataBase and absolute share URLs.
# On Vercel this is derived automatically from the deployment, so you only need
# to set it once a custom domain is live. Do not copy a localhost value to Vercel.
# NEXT_PUBLIC_SITE_URL=https://news.pti.edu.ng

# Postgres for Drizzle (src/db). On Supabase use the *Transaction pooler* URI
# (Connect → Transaction pooler, port 6543). The direct db.<ref>.supabase.co
# host is IPv6-only and unreachable from Vercel. URL-encode special characters
# in the password.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# Supabase project URL and publishable key (Project Settings → API Keys).
# NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted as an older name for the same key.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service role / secret key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
