# Copy to .env.local for local development. Do not commit .env.local.
#
# Nothing here is required to build or run the site today — the content layer
# in src/lib/content is seed-backed, so `npm run dev` and `npm run build` both
# work with no environment at all.

# Canonical origin, used for metadataBase and absolute share URLs.
# On Vercel this is derived automatically from the deployment, so you only need
# to set it once a custom domain is live.
# NEXT_PUBLIC_SITE_URL=https://news.pti.edu.ng

# Postgres connection for the Drizzle schema in src/db/schema.ts.
# Only needed once src/lib/content/queries.ts is moved off seed data.
# DATABASE_URL=postgres://user:password@host:5432/pti_news

# Supabase, for the helpers in src/utils/supabase. Not wired to any page yet;
# note there is no root middleware.ts, so session refresh does not run.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
